{
    "name": "impresscms/laravel-bridge-host",
    "description": "Laravel-hosted strangler bridge for legacy ImpressCMS",
    "type": "project",
    "require": {
        "php": "^8.3",
        "illuminate/container": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/http": "^11.0",
        "illuminate/routing": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
