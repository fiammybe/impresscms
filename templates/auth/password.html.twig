{# The new password after a reset link (App\Controller\Auth\Password) #}
<div class="icms-auth-password">
	<h1>{{ title }}</h1>
	{% if error %}<p class="errorMsg">{{ error|raw }}</p>{% endif %}
	<form method="post" action="{{ action }}">
		<div><label for="icms-password">{{ label_password }}</label><br />
		<input type="password" id="icms-password" name="password" autocomplete="new-password" required /></div>
		<div><label for="icms-password2">{{ label_repeat }}</label><br />
		<input type="password" id="icms-password2" name="password2" autocomplete="new-password" required /></div>
		<input type="hidden" name="_token" value="{{ token }}" />
		<div><br /><input type="submit" value="{{ button }}" /></div>
	</form>
</div>
