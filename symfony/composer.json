{
  "name": "impresscms/symfony-shell",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "symfony/config": "^7.3",
    "symfony/dependency-injection": "^7.3",
    "symfony/framework-bundle": "^7.3",
    "symfony/http-foundation": "^7.3",
    "symfony/http-kernel": "^7.3",
    "symfony/routing": "^7.3",
    "symfony/string": "^7.3",
    "symfony/yaml": "^7.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"echo 'Symfony shell installed'.PHP_EOL;\""
    ]
  }
}
