# ImpressCMS on FrankenPHP (classic mode) or Caddy (docs/symfony-host.md).
#
# Adjust the site address and root (the web root: the contents of htdocs/).
# ImpressCMS needs every PHP request to reach index.php and so the host (routing
# level 3): @php sends every script there, and php_server sends unknown paths
# there too.
#
# Do not enable FrankenPHP's worker mode: ImpressCMS keeps request state in
# static properties. Caddy ignores .htaccess files: @never replaces them.

example.test {
	root * /var/www/impresscms

	# Never served: the host's staging directory, compiled templates, caches,
	# tests, PHP files in uploads/, hidden files and folders, and directories
	# that ImpressCMS protects with their own .htaccess.
	@never path_regexp ^/(trust_dist|templates_c|cache|tests|plugins/waiting|libraries/tcpdf/tools|install/modules/protector/trust_path)(/|$)|^/uploads/.*\.php$|/\.
	respond @never 404

	@php path *.php
	rewrite @php /index.php

	php_server
}
